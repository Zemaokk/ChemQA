/data/*
!/data/README.md

# Downloaded models and caches
/models/

# Generated QA sessions, experiments, logs and plots
# Custom output destinations outside these paths need their own ignore rules.
/output/
/test_output/
/enhanced_api_output/
/example_answers/
/qa_testing/test_output/
/qa_testing/direct_api_output/
/heatmap_visualization/organic_electrocatalysis_heatmap.png
/organic_electrocatalysis_heatmap.png
*.log

# Intentionally tracked: source/tests/scripts, dependency locks, .env.example,
# config/, evaluation/, docs/ audit records and authored doc/report.pdf.
# Avoid blanket *.json / *.pdf / *.png rules: reviewed assets can be source.
