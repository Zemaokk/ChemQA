# Copy to .env and fill in your own key. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TEMPERATURE=0.3
# Explicit DeepSeek-style thinking switch; provider compatibility must be verified.
DEEPSEEK_THINKING=disabled
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_CONNECT_TIMEOUT=10
DEEPSEEK_READ_TIMEOUT=120
DEEPSEEK_MAX_ATTEMPTS=3

# Provider-specific alternative (set BOTH URL and model; never use a real key here):
# Paratera documentation: https://ai.paratera.com/document/llm/quickStart/useApi
# DEEPSEEK_BASE_URL=https://llmapi.paratera.com/v1
# DEEPSEEK_MODEL=DeepSeek-V4-Flash
# DEEPSEEK_* names are retained for compatibility with the current handler.

# Official model identifier; Q0 compared 12 stored vectors with this revision.
CHEMQA_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
CHEMQA_EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42

# Optional: keep downloaded model cache inside the ignored project models folder.
HF_HOME=models/huggingface

# Paths are relative to the project root, independent of the launch directory.
# Leave index/processed overrides unset to read the existing legacy data layout.
# CHEMQA_INDEX_DIR=output/indexes/<candidate-id>
# CHEMQA_PROCESSED_DIR=output/indexes/<candidate-id>
# CHEMQA_RAW_PAPERS_DIR=data/raw_papers
CHEMQA_OUTPUT_DIR=output
CHEMQA_MODEL_DIR=models

# Q06.5-E: optional raw-retrieval candidate; leave unset for the current default.
# Select BOTH a published ready index and its pinned embedding profile.
# CHEMQA_EMBEDDING_PROFILE=config/q065e_embedding.json
# CHEMQA_INDEX_DIR=output/indexes/<ready-run>
# Candidate context retrieval requires an explicitly selected similarity threshold.

# Q06.5-F: the same profile/index pair also selects a ready NumPy/SQLite candidate.
# Migration: docs/how-to/build-index.md; rollback: docs/how-to/frozen-runtime.md
